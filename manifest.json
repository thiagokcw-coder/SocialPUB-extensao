{
  "manifest_version": 3,
  "name": "SocialPUB",
  "version": "0.8.30",
  "description": "Prepara e publica no X, Instagram (Reel), TikTok, Threads e Facebook, por persona — anexa, escreve, confere e publica (ou para antes do botão final).",
  "permissions": [
    "scripting",
    "tabs",
    "debugger",
    "downloads",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.threads.com/*",
    "https://*.threads.net/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SocialPUB — abrir o painel"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
